{
	"name": "solidjs-bff",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev:frontend": "vite",
		"dev:backend": "ts-node-dev ./src/backend/index.ts",
		"dev": "npm run dev:backend & npm run dev:frontend",
		"lint": "tsc -b",
		"build:frontend": "vite build",
		"build:backend": "esbuild ./server.ts --bundle --platform=node --outfile=./dist/server.js --minify",
		"build": "npm run lint && rimraf ./dist && npm run build:frontend && npm run build:backend",
		"start": "node ./dist/server.js"
	},
	"dependencies": {
		"@fastify/cookie": "11.0.2",
		"@fastify/multipart": "^9.0.3",
		"@fastify/session": "11.1.0",
		"@fastify/static": "8.1.1",
		"fastify": "^5.2.2",
		"pretty-cache-header": "1.0.0",
		"solid-js": "^1.9.5"
	},
	"devDependencies": {
		"@types/node": "22.13.13",
		"dotenv": "16.4.7",
		"esbuild": "^0.25.1",
		"rimraf": "6.0.1",
		"terser": "^5.39.0",
		"ts-node-dev": "2.0.0",
		"typescript": "5.8.2",
		"vite": "^6.2.3",
		"vite-plugin-compression": "0.5.1",
		"vite-plugin-full-reload": "1.2.0",
		"vite-plugin-solid": "2.11.6"
	}
}
